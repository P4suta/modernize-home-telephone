{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>P4suta/renovate-config"],
  "packageRules": [
    {
      "matchFileNames": [
        "deploy/app/Dockerfile",
        "deploy/asterisk/Dockerfile",
        "verification/Dockerfile.sip",
        "verification/Dockerfile.web"
      ],
      "matchDatasources": ["deb"],
      "registryUrls": [
        "https://deb.debian.org/debian?suite=trixie&components=main&binaryArch=arm64",
        "https://deb.debian.org/debian?suite=trixie-updates&components=main&binaryArch=arm64",
        "https://security.debian.org/debian-security?suite=trixie-security&components=main&binaryArch=arm64"
      ]
    },
    {
      "matchPackageNames": ["*"],
      "automerge": false
    }
  ],
  "vulnerabilityAlerts": {
    "automerge": false
  }
}
