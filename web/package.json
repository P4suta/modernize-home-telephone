{
	"name": "homephone-web",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.17.0",
	"engines": {
		"node": ">=26.13.0"
	},
	"scripts": {
		"dev": "vite --host 127.0.0.1",
		"build": "tsc --noEmit && tsc --noEmit -p codegen && tsc --noEmit -p worker && vite build",
		"check": "tsc --noEmit && tsc --noEmit -p codegen && tsc --noEmit -p worker && vitest run",
		"test": "vitest run",
		"e2e": "playwright test",
		"generate": "pnpm --dir codegen exec openapi-typescript ../../api/openapi.json -o ../src/generated/api.d.ts",
		"mutate": "node mutation/node_modules/@stryker-mutator/core/bin/stryker.js run"
	},
	"dependencies": {
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"sip.js": "0.21.2",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@biomejs/biome": "2.6.4",
		"@playwright/test": "1.64.1",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.8",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@typescript/native": "npm:typescript@7.0.2",
		"@vitejs/plugin-react": "6.2.1",
		"@vitest/coverage-v8": "5.1.0",
		"jsdom": "30.1.3",
		"oxlint": "1.91.0",
		"oxlint-tsgolint": "7.0.2005",
		"typescript": "7.0.2",
		"vite": "8.3.6",
		"vitest": "5.1.0"
	}
}
