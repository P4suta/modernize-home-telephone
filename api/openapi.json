  "components": {
    "schemas": {
      "Call": {
        "type": "object",
        "required": [
          "id",
          "direction",
          "caller",
          "phase",
          "started_at",
          "transcript",
          "recording",
          "processing"
        ],
        "properties": {
          "caller": {
            "type": "string"
          },
          "direction": {
            "type": "string"
          },
          "ended_at": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "last_error": {
            "type": [
              "string",
              "null"
            ]
          },
          "phase": {
            "$ref": "#/components/schemas/Phase"
          },
          "processing": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "recording": {
            "$ref": "#/components/schemas/Recording"
          },
          "started_at": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "transcript": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Transcript"
            }
          }
        }
      },
      "Command": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "answer"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "hangup"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "takeover"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "hold"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "resume"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "digits",
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "dtmf"
                ]
              },
              "digits": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "text",
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "speak"
                ]
              },
              "text": {
                "type": "string"
              }
            }
          }
        ]
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Event": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "created_at"
        ],
        "properties": {
          "call": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Call"
              }
            ]
          },
          "created_at": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "kind": {
            "type": "string"
          }
        }
      },
      "LabIncoming": {
        "type": "object",
        "required": [
          "scenario"
        ],
        "properties": {
          "scenario": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "LabResult": {
        "type": "object",
        "required": [
          "channel_id"
        ],
        "properties": {
          "channel_id": {
            "type": "string"
          }
        }
      },
      "Maintenance": {
        "type": "object",
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "Originate": {
        "type": "object",
        "required": [
          "number"
        ],
        "properties": {
          "number": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Phase": {
        "type": "string",
        "enum": [
          "offered",
          "screening",
          "ringing",
          "connected",
          "held",
          "voicemail",
          "ended"
        ]
      },
      "PushKeys": {
        "type": "object",
        "required": [
          "p256dh",
          "auth"
        ],
        "properties": {
          "auth": {
            "type": "string"
          },
          "p256dh": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PushSubscription": {
        "type": "object",
        "required": [
          "endpoint",
          "keys"
        ],
        "properties": {
          "endpoint": {
            "type": "string"
          },
          "keys": {
            "$ref": "#/components/schemas/PushKeys"
          }
        },
        "additionalProperties": false
      },
      "Recording": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "none"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "pending"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "bytes",
              "status"
            ],
            "properties": {
              "bytes": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "status": {
                "type": "string",
                "enum": [
                  "available"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "reason",
              "status"
            ],
            "properties": {
              "reason": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "deleted"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "reason",
              "status"
            ],
            "properties": {
              "reason": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "failed"
                ]
              }
            }
          }
        ]
      },
      "Rule": {
        "type": "string",
        "enum": [
          "allow",
          "block",
          "screen"
        ]
      },
      "Settings": {
        "type": "object",
        "properties": {
          "recording_limit_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "default": null,
            "minimum": 0
          },
          "retention_days": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "default": null,
            "minimum": 0
          },
          "rules": {
            "type": "object",
            "default": {},
            "additionalProperties": {
              "$ref": "#/components/schemas/Rule"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "webhook_url": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          }
        },
        "additionalProperties": false
      },
      "SipSession": {
        "type": "object",
        "required": [
          "domain",
          "username",
          "password"
        ],
        "properties": {
          "domain": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "Snapshot": {
        "type": "object",
        "required": [
          "calls",
          "cursor"
        ],
        "properties": {
          "calls": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Call"
            }
          },
          "cursor": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "SnapshotResult": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Status": {
        "type": "object",
        "required": [
          "instance_id",
          "mode",
          "gateway_ready",
          "ai_configured"
        ],
        "properties": {
          "ai_configured": {
            "type": "boolean"
          },
          "gateway_ready": {
            "type": "boolean"
          },
          "instance_id": {
            "type": "string",
            "format": "uuid"
          },
          "mode": {
            "type": "string"
          },
          "vapid_public_key": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Transcript": {
        "type": "object",
        "required": [
          "item_id",
          "speaker",
          "text"
        ],
        "properties": {
          "item_id": {
            "type": "string"
          },
          "speaker": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    }
  }
}