FROM rust:1.99.1-trixie@sha256:8a4e90c7946b74626488b1446f712c0fe0ed1a596cbd3d871684bc9c5433ae07 AS trust
FROM node:26.13.0-trixie-slim@sha256:5adad64f9a1fca2d51972caa65983634c8a774eb300d72b20f7f2a0f60368072
COPY --from=trust /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY deploy/apt-trust.conf /etc/apt/apt.conf.d/90homephone-trust
COPY deploy/debian.sources /etc/apt/sources.list.d/debian.sources
RUN apt-get update && apt-get install -y --no-install-recommends procps=2:4.0.4-9 && rm -rf /var/lib/apt/lists/*
RUN npm install --global pnpm@12.17.0
WORKDIR /opt/console
COPY console/package.json console/pnpm-lock.yaml console/pnpm-workspace.yaml ./
COPY console/mutation/package.json ./mutation/package.json
COPY console/packages/settings-workflow/package.json ./packages/settings-workflow/package.json
COPY console/patches ./patches
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY console/ ./
RUN pnpm build:packages && pnpm exec svelte-kit sync
